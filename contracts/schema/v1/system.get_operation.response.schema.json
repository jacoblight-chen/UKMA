{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/system.get_operation.response.schema.json",
  "title": "system.get_operation Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "request_id",
    "trace_id",
    "status",
    "warnings",
    "partial_reasons",
    "freshness"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "request_id": {
      "$ref": "shared.schema.json#/$defs/ID"
    },
    "trace_id": {
      "$ref": "shared.schema.json#/$defs/ID"
    },
    "status": {
      "$ref": "shared.schema.json#/$defs/Status"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "api_major": {
          "const": 1
        },
        "domain": {
          "$ref": "shared.schema.json#/$defs/Domain"
        },
        "request_schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "response_schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "required_scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "idempotency": {
          "enum": [
            "required",
            "not_required"
          ]
        },
        "concurrency": {
          "enum": [
            "expected_etag",
            "immutable_snapshot",
            "not_applicable"
          ]
        },
        "consistency_modes": {
          "type": "array",
          "items": {
            "$ref": "shared.schema.json#/$defs/Consistency"
          }
        },
        "error_codes": {
          "type": "array",
          "items": {
            "$ref": "shared.schema.json#/$defs/ErrorCode"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "required": [
        "operation_id",
        "api_major",
        "domain",
        "request_schema",
        "response_schema",
        "required_scopes",
        "idempotency",
        "concurrency",
        "consistency_modes",
        "error_codes",
        "events",
        "tests"
      ]
    },
    "error": {
      "$ref": "shared.schema.json#/$defs/ErrorDetail"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "partial_reasons": {
      "type": "array",
      "items": {
        "$ref": "shared.schema.json#/$defs/PartialReason"
      }
    },
    "snapshot_id": {
      "$ref": "shared.schema.json#/$defs/ID"
    },
    "index_generation": {
      "$ref": "shared.schema.json#/$defs/ID"
    },
    "freshness": {
      "$ref": "shared.schema.json#/$defs/Freshness"
    },
    "observed_revision": {
      "$ref": "shared.schema.json#/$defs/ID"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "data"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "partial"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "data"
        ],
        "properties": {
          "partial_reasons": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
