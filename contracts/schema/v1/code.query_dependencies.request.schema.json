{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/code.query_dependencies.request.schema.json",
  "title": "code.query_dependencies Request (Phase 4 typed candidate)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.code.query_dependencies.v1"
    },
    "context": {
      "$ref": "shared.schema.json#/$defs/RequestContext"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "allOf": [
            {
              "$ref": "shared.schema.json#/$defs/TraversalQuery"
            },
            {
              "type": "object",
              "properties": {
                "edge_kinds": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "depends_on",
                      "imports"
                    ]
                  },
                  "minItems": 1
                }
              }
            }
          ]
        }
      },
      "required": [
        "query"
      ]
    }
  }
}
