{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/system.capabilities.request.schema.json",
  "title": "system.capabilities Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.system.capabilities.v1"
    },
    "context": {
      "$ref": "shared.schema.json#/$defs/RequestContext"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "$ref": "shared.schema.json#/$defs/ScopeRef"
        }
      },
      "required": []
    }
  }
}
