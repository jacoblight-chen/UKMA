{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/memory.verify_fact.request.schema.json",
  "title": "memory.verify_fact Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.memory.verify_fact.v1"
    },
    "context": {
      "$ref": "#/$defs/shared.RequestContext"
    },
    "input": {
      "$ref": "#/$defs/wire.VerifyFact"
    }
  },
  "$defs": {
    "wire.FactDecision": {
      "description": "Review decision of `memory.verify_fact` (\u00a734.2).",
      "oneOf": [
        {
          "description": "Accept the claim.",
          "enum": [
            "verify"
          ],
          "type": "string"
        },
        {
          "description": "Reject the claim.",
          "enum": [
            "reject"
          ],
          "type": "string"
        }
      ]
    },
    "wire.MemoryKind": {
      "description": "Which memory store an item lives in (\u00a734.1).",
      "oneOf": [
        {
          "description": "Working memory: session/agent scoped and budgeted.",
          "enum": [
            "working"
          ],
          "type": "string"
        },
        {
          "description": "Episodic memory: TTL and FSRS driven.",
          "enum": [
            "episodic"
          ],
          "type": "string"
        },
        {
          "description": "Semantic memory: versioned, evidence-backed facts.",
          "enum": [
            "semantic"
          ],
          "type": "string"
        },
        {
          "description": "Procedural memory: abstract procedures only, never tool grants.",
          "enum": [
            "procedural"
          ],
          "type": "string"
        }
      ]
    },
    "wire.MemoryRef": {
      "description": "Address of one memory record.",
      "properties": {
        "id": {
          "description": "Memory id.",
          "type": "string"
        },
        "kind": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.MemoryKind"
            }
          ],
          "description": "Store the id belongs to."
        },
        "revision": {
          "description": "Revision or content tag the caller observed.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "revision"
      ],
      "type": "object"
    },
    "wire.VerifyFact": {
      "description": "`memory.verify_fact` (MAPI-11 \u2014 implemented in P6).",
      "properties": {
        "decision": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.FactDecision"
            }
          ],
          "description": "Decision."
        },
        "evidence_ids": {
          "description": "Independent evidence used for the decision.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expected_etag": {
          "description": "Caller's etag.",
          "type": "string"
        },
        "fact": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.MemoryRef"
            }
          ],
          "description": "Claim under review."
        }
      },
      "required": [
        "decision",
        "evidence_ids",
        "expected_etag",
        "fact"
      ],
      "type": "object"
    },
    "shared.ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shared.ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "shared.Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "shared.ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "project_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "repo_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "workspace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "agent_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "session_id": {
          "$ref": "#/$defs/shared.ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "shared.RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "trace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scope": {
          "$ref": "#/$defs/shared.ScopeRef"
        },
        "principal_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "#/$defs/shared.ISODate"
        },
        "consistency": {
          "$ref": "#/$defs/shared.Consistency"
        },
        "required_generation": {
          "$ref": "#/$defs/shared.ID"
        },
        "snapshot_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "idempotency_key": {
          "$ref": "#/$defs/shared.ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    }
  }
}
