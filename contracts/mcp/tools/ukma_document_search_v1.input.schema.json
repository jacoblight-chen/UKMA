{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/document.search.request.schema.json",
  "title": "document.search Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.document.search.v1"
    },
    "context": {
      "$ref": "#/$defs/shared.RequestContext"
    },
    "input": {
      "$ref": "#/$defs/wire.SearchDocument"
    }
  },
  "$defs": {
    "wire.DocumentBlockKind": {
      "description": "Kind of a document block (`\u00a733.1 DocumentBlock.kind`).",
      "oneOf": [
        {
          "description": "Section heading.",
          "enum": [
            "heading"
          ],
          "type": "string"
        },
        {
          "description": "Paragraph.",
          "enum": [
            "paragraph"
          ],
          "type": "string"
        },
        {
          "description": "Table.",
          "enum": [
            "table"
          ],
          "type": "string"
        },
        {
          "description": "Table cell.",
          "enum": [
            "table_cell"
          ],
          "type": "string"
        },
        {
          "description": "List (container).",
          "enum": [
            "list"
          ],
          "type": "string"
        },
        {
          "description": "Code block.",
          "enum": [
            "code"
          ],
          "type": "string"
        },
        {
          "description": "Image; without OCR it stays `unparsed`.",
          "enum": [
            "image"
          ],
          "type": "string"
        },
        {
          "description": "Footnote.",
          "enum": [
            "footnote"
          ],
          "type": "string"
        },
        {
          "description": "Anything else.",
          "enum": [
            "other"
          ],
          "type": "string"
        }
      ]
    },
    "wire.DocumentPageRequest": {
      "description": "Page request (\u00a731.4). Kept local so the crate has no wire dependency.",
      "properties": {
        "cursor": {
          "description": "Opaque cursor.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "description": "Maximum items.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "limit"
      ],
      "type": "object"
    },
    "wire.SearchDocument": {
      "description": "`document.search` (DAPI-06).",
      "properties": {
        "block_kinds": {
          "description": "Restrict to these block kinds.",
          "items": {
            "$ref": "#/$defs/wire.DocumentBlockKind"
          },
          "type": "array"
        },
        "document_refs": {
          "description": "Restrict to these documents.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "languages": {
          "description": "Restrict to these languages.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "page": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.DocumentPageRequest"
            }
          ],
          "description": "Page."
        },
        "project_id": {
          "description": "Project.",
          "type": "string"
        },
        "query": {
          "description": "Query string.",
          "type": "string"
        },
        "tenant_id": {
          "description": "Scope the search runs in.",
          "type": "string"
        }
      },
      "required": [
        "block_kinds",
        "document_refs",
        "languages",
        "page",
        "project_id",
        "query",
        "tenant_id"
      ],
      "type": "object"
    },
    "shared.ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shared.ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "shared.Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "shared.ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "project_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "repo_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "workspace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "agent_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "session_id": {
          "$ref": "#/$defs/shared.ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "shared.RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "trace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scope": {
          "$ref": "#/$defs/shared.ScopeRef"
        },
        "principal_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "#/$defs/shared.ISODate"
        },
        "consistency": {
          "$ref": "#/$defs/shared.Consistency"
        },
        "required_generation": {
          "$ref": "#/$defs/shared.ID"
        },
        "snapshot_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "idempotency_key": {
          "$ref": "#/$defs/shared.ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    }
  }
}
