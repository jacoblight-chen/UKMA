{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/memory.put_working_block.request.schema.json",
  "title": "memory.put_working_block Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.memory.put_working_block.v1"
    },
    "context": {
      "$ref": "#/$defs/shared.RequestContext"
    },
    "input": {
      "$ref": "#/$defs/wire.PutWorkingBlock"
    }
  },
  "$defs": {
    "wire.MemoryBlockKind": {
      "description": "Kind of working memory block (\u00a721.2).",
      "oneOf": [
        {
          "description": "What the task currently is.",
          "enum": [
            "task_state"
          ],
          "type": "string"
        },
        {
          "description": "Output of a tool call.",
          "enum": [
            "tool_output"
          ],
          "type": "string"
        },
        {
          "description": "Recent conversation content.",
          "enum": [
            "recent_message"
          ],
          "type": "string"
        },
        {
          "description": "Context the agent asked to keep.",
          "enum": [
            "active_context"
          ],
          "type": "string"
        },
        {
          "description": "Result of folding a sub-agent scope.",
          "enum": [
            "folded_result"
          ],
          "type": "string"
        }
      ]
    },
    "wire.PutWorkingBlock": {
      "description": "`memory.put_working_block` (MAPI-03).",
      "properties": {
        "automatic": {
          "description": "Whether the block was auto-generated by the runtime this turn.",
          "type": "boolean"
        },
        "input": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.WorkingBlockInput"
            }
          ],
          "description": "Block to write."
        }
      },
      "required": [
        "automatic",
        "input"
      ],
      "type": "object"
    },
    "wire.WorkingBlockInput": {
      "description": "Input of `memory.put_working_block` (\u00a734.1).",
      "properties": {
        "agent_id": {
          "description": "Agent the block belongs to.",
          "type": "string"
        },
        "block_type": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.MemoryBlockKind"
            }
          ],
          "description": "Block kind."
        },
        "content": {
          "description": "Block content.",
          "type": "string"
        },
        "expires_after_turns": {
          "description": "Optional turn-based expiry.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "language": {
          "description": "BCP-47 language.",
          "type": "string"
        },
        "priority": {
          "description": "Priority in `[0,1]`.",
          "format": "double",
          "type": "number"
        },
        "protected": {
          "description": "Whether the block is pinned by the user (\u00a722.2 R6).",
          "type": "boolean"
        },
        "session_id": {
          "description": "Session the block belongs to.",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "block_type",
        "content",
        "language",
        "priority",
        "protected",
        "session_id"
      ],
      "type": "object"
    },
    "shared.ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shared.ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "shared.Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "shared.ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "project_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "repo_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "workspace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "agent_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "session_id": {
          "$ref": "#/$defs/shared.ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "shared.RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "trace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scope": {
          "$ref": "#/$defs/shared.ScopeRef"
        },
        "principal_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "#/$defs/shared.ISODate"
        },
        "consistency": {
          "$ref": "#/$defs/shared.Consistency"
        },
        "required_generation": {
          "$ref": "#/$defs/shared.ID"
        },
        "snapshot_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "idempotency_key": {
          "$ref": "#/$defs/shared.ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    }
  }
}
