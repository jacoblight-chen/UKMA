{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/code.find_symbols.request.schema.json",
  "title": "code.find_symbols Request (Phase 4 typed candidate)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.code.find_symbols.v1"
    },
    "context": {
      "$ref": "#/$defs/shared.RequestContext"
    },
    "input": {
      "$ref": "#/$defs/wire.SymbolQuery"
    }
  },
  "$defs": {
    "wire.CodePageRequest": {
      "description": "A page request (§31.4). `limit` is bounded; `cursor` is opaque.",
      "properties": {
        "cursor": {
          "description": "Opaque cursor from a previous page.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "description": "Maximum items to return (1..=200).",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "limit"
      ],
      "type": "object"
    },
    "wire.SymbolKind": {
      "description": "Symbol kind (§32.1 `Symbol.symbol_kind`).",
      "oneOf": [
        {
          "description": "Module or package.",
          "enum": [
            "module"
          ],
          "type": "string"
        },
        {
          "description": "Class.",
          "enum": [
            "class"
          ],
          "type": "string"
        },
        {
          "description": "Struct.",
          "enum": [
            "struct"
          ],
          "type": "string"
        },
        {
          "description": "Trait.",
          "enum": [
            "trait"
          ],
          "type": "string"
        },
        {
          "description": "Interface.",
          "enum": [
            "interface"
          ],
          "type": "string"
        },
        {
          "description": "Free function.",
          "enum": [
            "function"
          ],
          "type": "string"
        },
        {
          "description": "Method.",
          "enum": [
            "method"
          ],
          "type": "string"
        },
        {
          "description": "Struct/class field.",
          "enum": [
            "field"
          ],
          "type": "string"
        },
        {
          "description": "Variable.",
          "enum": [
            "variable"
          ],
          "type": "string"
        },
        {
          "description": "Constant.",
          "enum": [
            "constant"
          ],
          "type": "string"
        },
        {
          "description": "Enum.",
          "enum": [
            "enum"
          ],
          "type": "string"
        },
        {
          "description": "Anything else.",
          "enum": [
            "other"
          ],
          "type": "string"
        }
      ]
    },
    "wire.SymbolQuery": {
      "description": "Request: symbol search (`CAPI-05`).",
      "properties": {
        "kinds": {
          "description": "Restrict to these kinds (empty means all).",
          "items": {
            "$ref": "#/$defs/wire.SymbolKind"
          },
          "type": "array"
        },
        "language": {
          "description": "Restrict to this language.",
          "type": [
            "string",
            "null"
          ]
        },
        "page": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.CodePageRequest"
            }
          ],
          "description": "Page."
        },
        "path_glob": {
          "description": "Restrict to this path glob.",
          "type": [
            "string",
            "null"
          ]
        },
        "query": {
          "description": "Case-insensitive substring matched against name and qualified name.",
          "type": "string"
        },
        "repository_id": {
          "description": "Repository the query is bound to.",
          "type": "string"
        },
        "revision": {
          "description": "Revision (commit SHA).",
          "type": "string"
        }
      },
      "required": [
        "kinds",
        "page",
        "query",
        "repository_id",
        "revision"
      ],
      "type": "object"
    },
    "shared.ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shared.ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "shared.Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "shared.ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "project_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "repo_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "workspace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "agent_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "session_id": {
          "$ref": "#/$defs/shared.ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "shared.RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "trace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scope": {
          "$ref": "#/$defs/shared.ScopeRef"
        },
        "principal_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "#/$defs/shared.ISODate"
        },
        "consistency": {
          "$ref": "#/$defs/shared.Consistency"
        },
        "required_generation": {
          "$ref": "#/$defs/shared.ID"
        },
        "snapshot_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "idempotency_key": {
          "$ref": "#/$defs/shared.ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    }
  }
}
