{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/code.get_ai_context.request.schema.json",
  "title": "code.get_ai_context Request (Phase 4 typed candidate)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.code.get_ai_context.v1"
    },
    "context": {
      "$ref": "#/$defs/shared.RequestContext"
    },
    "input": {
      "$ref": "#/$defs/wire.AiContextQuery"
    }
  },
  "$defs": {
    "wire.AiContextQuery": {
      "description": "Request: intent-aware context assembly (`get_ai_context` parity).",
      "properties": {
        "intent": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.ContextIntent"
            }
          ],
          "description": "Caller intent."
        },
        "max_tokens": {
          "description": "Hard token budget.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "repository_id": {
          "description": "Repository the request is bound to.",
          "type": "string"
        },
        "revision": {
          "description": "Revision (commit SHA or a registered alias such as `@cwd`).",
          "type": "string"
        },
        "target_refs": {
          "description": "Symbols to build the context around.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "intent",
        "max_tokens",
        "repository_id",
        "revision",
        "target_refs"
      ],
      "type": "object"
    },
    "wire.ContextIntent": {
      "description": "Caller intent for context assembly (`get_ai_context` parity).",
      "oneOf": [
        {
          "description": "Why the code is written: definitions, docs, related symbols.",
          "enum": [
            "explain"
          ],
          "type": "string"
        },
        {
          "description": "What a modification touches: source, callers, dependants, tests.",
          "enum": [
            "modify"
          ],
          "type": "string"
        },
        {
          "description": "What to inspect when it misbehaves: callers, error handling, hints.",
          "enum": [
            "debug"
          ],
          "type": "string"
        },
        {
          "description": "How the code is exercised: tests, references, coverage candidates.",
          "enum": [
            "test"
          ],
          "type": "string"
        }
      ]
    },
    "shared.ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shared.ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "shared.Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "shared.ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "project_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "repo_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "workspace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "agent_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "session_id": {
          "$ref": "#/$defs/shared.ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "shared.RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "trace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scope": {
          "$ref": "#/$defs/shared.ScopeRef"
        },
        "principal_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "#/$defs/shared.ISODate"
        },
        "consistency": {
          "$ref": "#/$defs/shared.Consistency"
        },
        "required_generation": {
          "$ref": "#/$defs/shared.ID"
        },
        "snapshot_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "idempotency_key": {
          "$ref": "#/$defs/shared.ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    }
  }
}
