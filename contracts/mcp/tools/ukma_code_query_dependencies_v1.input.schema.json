{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/code.query_dependencies.request.schema.json",
  "title": "code.query_dependencies Request (Phase 4 typed candidate)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.code.query_dependencies.v1"
    },
    "context": {
      "$ref": "#/$defs/RequestContext"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "allOf": [
            {
              "$ref": "#/$defs/TraversalQuery"
            },
            {
              "type": "object",
              "properties": {
                "edge_kinds": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "depends_on",
                      "imports"
                    ]
                  },
                  "minItems": 1
                }
              }
            }
          ]
        }
      },
      "required": [
        "query"
      ]
    }
  },
  "$defs": {
    "ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "Hash": {
      "type": "string",
      "pattern": "^[a-z0-9-]+:[0-9a-f]{8,}$"
    },
    "Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "Domain": {
      "enum": [
        "code",
        "document",
        "memory",
        "traceability"
      ]
    },
    "Status": {
      "enum": [
        "ok",
        "partial",
        "error"
      ]
    },
    "ValidationState": {
      "enum": [
        "unverified",
        "candidate",
        "verified",
        "rejected",
        "stale"
      ]
    },
    "OperationStatus": {
      "enum": [
        "queued",
        "running",
        "ready",
        "partial",
        "failed",
        "cancelled"
      ]
    },
    "Freshness": {
      "enum": [
        "current",
        "stale",
        "rebuilding",
        "unknown"
      ]
    },
    "ErrorCode": {
      "enum": [
        "INVALID_SCHEMA",
        "INVALID_ARGUMENT",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "NOT_FOUND",
        "SOURCE_REVISION_MISMATCH",
        "ETAG_MISMATCH",
        "IDEMPOTENCY_CONFLICT",
        "CURSOR_EXPIRED",
        "CAPABILITY_UNAVAILABLE",
        "CONSISTENCY_UNSUPPORTED",
        "INDEX_STALE",
        "INDEX_NOT_READY",
        "SOURCE_PARSE_FAILED",
        "UNSUPPORTED_MEDIA_TYPE",
        "SOURCE_UNAVAILABLE",
        "SOURCE_TOO_LARGE",
        "RESOURCE_LIMIT",
        "INSUFFICIENT_CONTEXT_BUDGET",
        "CONTEXT_BUDGET_EXCEEDED",
        "CONFLICTING_EVIDENCE",
        "EVIDENCE_REQUIRED",
        "LINK_STATE_CONFLICT",
        "CROSS_SCOPE_DENIED",
        "DELEGATION_EXPIRED",
        "POLICY_DENIED",
        "STORAGE_COMMIT_UNKNOWN",
        "STORAGE_UNAVAILABLE",
        "INDEX_PROJECTION_FAILED",
        "JOB_NOT_CANCELLABLE",
        "JOB_NOT_FOUND",
        "ALREADY_DELETED",
        "DELETION_BLOCKED",
        "MODEL_PROFILE_MISMATCH",
        "MODEL_UNAVAILABLE",
        "TIMEOUT",
        "INTERNAL"
      ]
    },
    "ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "shared.schema.json#/$defs/ID"
        },
        "project_id": {
          "$ref": "shared.schema.json#/$defs/ID"
        },
        "repo_id": {
          "$ref": "shared.schema.json#/$defs/ID"
        },
        "workspace_id": {
          "$ref": "shared.schema.json#/$defs/ID"
        },
        "agent_id": {
          "$ref": "shared.schema.json#/$defs/ID"
        },
        "session_id": {
          "$ref": "shared.schema.json#/$defs/ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "Ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain": {
          "enum": [
            "code",
            "document",
            "memory",
            "traceability",
            "shared"
          ]
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "id": {
          "$ref": "shared.schema.json#/$defs/ID"
        },
        "revision": {
          "$ref": "shared.schema.json#/$defs/ID"
        },
        "scope": {
          "$ref": "shared.schema.json#/$defs/ScopeRef"
        }
      },
      "required": [
        "domain",
        "kind",
        "id",
        "revision",
        "scope"
      ]
    },
    "Span": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "shared.schema.json#/$defs/Ref"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "byte_start": {
          "type": "integer",
          "minimum": 0
        },
        "byte_end": {
          "type": "integer",
          "minimum": 0
        },
        "page_start": {
          "type": "integer",
          "minimum": 1
        },
        "page_end": {
          "type": "integer",
          "minimum": 1
        },
        "heading_path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "table_cell": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "row": {
              "type": "integer",
              "minimum": 1
            },
            "column": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "row",
            "column"
          ]
        },
        "coordinate_system": {
          "enum": [
            "utf8_byte_0_based",
            "line_1_based",
            "pdf_page_1_based"
          ]
        }
      },
      "required": [
        "source",
        "media_type"
      ]
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "$ref": "shared.schema.json#/$defs/ID"
        },
        "ref": {
          "$ref": "shared.schema.json#/$defs/Ref"
        },
        "span": {
          "$ref": "shared.schema.json#/$defs/Span"
        },
        "content_hash": {
          "$ref": "shared.schema.json#/$defs/Hash"
        },
        "method": {
          "enum": [
            "parser",
            "static_analysis",
            "test",
            "human",
            "model",
            "imported"
          ]
        },
        "verification": {
          "$ref": "shared.schema.json#/$defs/ValidationState"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "trust": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "created_at": {
          "$ref": "shared.schema.json#/$defs/ISODate"
        },
        "valid_for_revision": {
          "$ref": "shared.schema.json#/$defs/ID"
        }
      },
      "required": [
        "evidence_id",
        "ref",
        "content_hash",
        "method",
        "verification",
        "created_at",
        "valid_for_revision"
      ]
    },
    "RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "shared.schema.json#/$defs/ID"
        },
        "trace_id": {
          "$ref": "shared.schema.json#/$defs/ID"
        },
        "scope": {
          "$ref": "shared.schema.json#/$defs/ScopeRef"
        },
        "principal_id": {
          "$ref": "shared.schema.json#/$defs/ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "shared.schema.json#/$defs/ISODate"
        },
        "consistency": {
          "$ref": "shared.schema.json#/$defs/Consistency"
        },
        "required_generation": {
          "$ref": "shared.schema.json#/$defs/ID"
        },
        "snapshot_id": {
          "$ref": "shared.schema.json#/$defs/ID"
        },
        "idempotency_key": {
          "$ref": "shared.schema.json#/$defs/ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    },
    "ErrorDetail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "shared.schema.json#/$defs/ErrorCode"
        },
        "safe_message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "retryable": {
          "type": "boolean"
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 0
        },
        "field_violations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "reason"
            ]
          }
        },
        "correlated_operation_id": {
          "$ref": "shared.schema.json#/$defs/ID"
        }
      },
      "required": [
        "code",
        "safe_message",
        "retryable"
      ]
    },
    "PartialReason": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "code": {
          "$ref": "shared.schema.json#/$defs/ErrorCode"
        },
        "detail": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "source",
        "code",
        "detail"
      ]
    },
    "PageRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "limit"
      ]
    },
    "JobHandle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "$ref": "shared.schema.json#/$defs/ID"
        },
        "job_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "$ref": "shared.schema.json#/$defs/OperationStatus"
        },
        "submitted_at": {
          "$ref": "shared.schema.json#/$defs/ISODate"
        },
        "source_revision": {
          "$ref": "shared.schema.json#/$defs/ID"
        },
        "target_generation": {
          "$ref": "shared.schema.json#/$defs/ID"
        }
      },
      "required": [
        "job_id",
        "job_kind",
        "status",
        "submitted_at"
      ]
    },
    "JobProgress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "done": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "stage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "done",
        "stage"
      ]
    },
    "JobView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "$ref": "shared.schema.json#/$defs/ID"
        },
        "job_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "$ref": "shared.schema.json#/$defs/OperationStatus"
        },
        "submitted_at": {
          "$ref": "shared.schema.json#/$defs/ISODate"
        },
        "source_revision": {
          "$ref": "shared.schema.json#/$defs/ID"
        },
        "target_generation": {
          "$ref": "shared.schema.json#/$defs/ID"
        },
        "started_at": {
          "$ref": "shared.schema.json#/$defs/ISODate"
        },
        "completed_at": {
          "$ref": "shared.schema.json#/$defs/ISODate"
        },
        "progress": {
          "$ref": "shared.schema.json#/$defs/JobProgress"
        },
        "result_ref": {
          "$ref": "shared.schema.json#/$defs/Ref"
        },
        "error": {
          "$ref": "shared.schema.json#/$defs/ErrorDetail"
        },
        "partial_reasons": {
          "type": "array",
          "items": {
            "$ref": "shared.schema.json#/$defs/PartialReason"
          }
        },
        "cancellable": {
          "type": "boolean"
        }
      },
      "required": [
        "job_id",
        "job_kind",
        "status",
        "submitted_at",
        "partial_reasons",
        "cancellable"
      ]
    },
    "LimitsProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_page_size": {
          "type": "integer",
          "minimum": 1
        },
        "max_batch_size": {
          "type": "integer",
          "minimum": 1
        },
        "max_query_chars": {
          "type": "integer",
          "minimum": 1
        },
        "max_graph_depth": {
          "type": "integer",
          "minimum": 1
        },
        "max_graph_nodes": {
          "type": "integer",
          "minimum": 1
        },
        "max_payload_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_deadline_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_vector_k": {
          "type": "integer",
          "minimum": 1
        },
        "max_context_tokens": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "max_page_size",
        "max_batch_size",
        "max_query_chars",
        "max_graph_depth",
        "max_graph_nodes",
        "max_payload_bytes",
        "max_deadline_ms",
        "max_vector_k",
        "max_context_tokens"
      ]
    },
    "ProjectionStatus": {
      "enum": [
        "pending",
        "ready",
        "failed"
      ]
    },
    "ChangeReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "shared.schema.json#/$defs/Ref"
        },
        "revision": {
          "$ref": "shared.schema.json#/$defs/ID"
        },
        "etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "canonical_committed": {
          "type": "boolean"
        },
        "projected_generation": {
          "$ref": "shared.schema.json#/$defs/ID"
        },
        "projection_status": {
          "$ref": "shared.schema.json#/$defs/ProjectionStatus"
        },
        "operation_id": {
          "$ref": "shared.schema.json#/$defs/ID"
        }
      },
      "required": [
        "ref",
        "revision",
        "etag",
        "canonical_committed",
        "projection_status",
        "operation_id"
      ]
    },
    "SearchHit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "shared.schema.json#/$defs/Ref"
        },
        "snippet": {
          "type": "string",
          "maxLength": 8000
        },
        "score": {
          "type": "number"
        },
        "channel_scores": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "maxProperties": 16
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "shared.schema.json#/$defs/Evidence"
          }
        },
        "validation": {
          "$ref": "shared.schema.json#/$defs/ValidationState"
        },
        "source_revision": {
          "$ref": "shared.schema.json#/$defs/ID"
        }
      },
      "required": [
        "ref",
        "score",
        "channel_scores",
        "evidence",
        "validation",
        "source_revision"
      ]
    },
    "ExecutionPhase": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "CommitPhase": {
      "enum": [
        "not_started",
        "not_committed",
        "committed",
        "unknown"
      ]
    },
    "ProjectionPhase": {
      "enum": [
        "not_required",
        "pending",
        "ready",
        "failed",
        "rebuilding"
      ]
    },
    "OperationOutcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "$ref": "shared.schema.json#/$defs/ID"
        },
        "execution": {
          "$ref": "shared.schema.json#/$defs/ExecutionPhase"
        },
        "commit": {
          "$ref": "shared.schema.json#/$defs/CommitPhase"
        },
        "projection": {
          "$ref": "shared.schema.json#/$defs/ProjectionPhase"
        },
        "canonical_revision": {
          "$ref": "shared.schema.json#/$defs/ID"
        },
        "receipt": {
          "$ref": "shared.schema.json#/$defs/ChangeReceipt"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "shared.schema.json#/$defs/ErrorDetail"
          }
        },
        "updated_at": {
          "$ref": "shared.schema.json#/$defs/ISODate"
        }
      },
      "required": [
        "operation_id",
        "execution",
        "commit",
        "projection",
        "diagnostics",
        "updated_at"
      ]
    },
    "HistoricalValidity": {
      "enum": [
        "valid",
        "invalid",
        "unverified"
      ]
    },
    "CurrentApplicability": {
      "enum": [
        "applicable",
        "requires_revalidation",
        "not_applicable",
        "unknown"
      ]
    },
    "IndexFreshness": {
      "enum": [
        "current",
        "lagging",
        "rebuilding",
        "unavailable",
        "unknown"
      ]
    },
    "ValidityVector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "historical_validity": {
          "$ref": "shared.schema.json#/$defs/HistoricalValidity"
        },
        "current_applicability": {
          "$ref": "shared.schema.json#/$defs/CurrentApplicability"
        },
        "index_freshness": {
          "$ref": "shared.schema.json#/$defs/IndexFreshness"
        },
        "asserted_source_revision": {
          "$ref": "shared.schema.json#/$defs/ID"
        },
        "observed_head_revision": {
          "$ref": "shared.schema.json#/$defs/ID"
        },
        "assessed_at": {
          "$ref": "shared.schema.json#/$defs/ISODate"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "shared.schema.json#/$defs/Ref"
          }
        }
      },
      "required": [
        "historical_validity",
        "current_applicability",
        "index_freshness",
        "asserted_source_revision",
        "assessed_at",
        "evidence_refs"
      ]
    },
    "RepoRevision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "$ref": "shared.schema.json#/$defs/Ref"
        },
        "vcs": {
          "const": "git"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty_policy": {
          "enum": [
            "reject",
            "snapshot"
          ]
        }
      },
      "required": [
        "repository",
        "vcs",
        "commit_sha",
        "dirty_policy"
      ]
    },
    "CodeLocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "$ref": "shared.schema.json#/$defs/Ref"
        },
        "span": {
          "$ref": "shared.schema.json#/$defs/Span"
        },
        "qualified_name": {
          "type": "string"
        }
      },
      "required": [
        "file",
        "span"
      ]
    },
    "Symbol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "shared.schema.json#/$defs/Ref"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "qualified_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "symbol_kind": {
          "enum": [
            "module",
            "class",
            "struct",
            "trait",
            "interface",
            "function",
            "method",
            "field",
            "variable",
            "constant",
            "enum",
            "other"
          ]
        },
        "signature": {
          "type": "string",
          "maxLength": 4096
        },
        "definition": {
          "$ref": "shared.schema.json#/$defs/CodeLocation"
        },
        "visibility": {
          "type": "string",
          "maxLength": 64
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "resolution": {
          "enum": [
            "resolved",
            "partial",
            "unresolved"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "shared.schema.json#/$defs/Evidence"
          }
        }
      },
      "required": [
        "ref",
        "name",
        "qualified_name",
        "symbol_kind",
        "definition",
        "language",
