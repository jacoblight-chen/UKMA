{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/memory.fold.request.schema.json",
  "title": "memory.fold Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.memory.fold.v1"
    },
    "context": {
      "$ref": "#/$defs/shared.RequestContext"
    },
    "input": {
      "$ref": "#/$defs/wire.FoldMemory"
    }
  },
  "$defs": {
    "wire.FoldInput": {
      "description": "Input of `memory.fold` (§34.1).",
      "properties": {
        "episode_refs": {
          "description": "Episodes (or blocks) to fold.",
          "items": {
            "$ref": "#/$defs/wire.MemoryRef"
          },
          "type": "array"
        },
        "max_tokens": {
          "description": "Token ceiling of the result.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "policy_id": {
          "description": "Policy that authorises the fold.",
          "type": "string"
        },
        "target_agent_id": {
          "description": "Agent the folded result belongs to.",
          "type": "string"
        }
      },
      "required": [
        "episode_refs",
        "max_tokens",
        "policy_id",
        "target_agent_id"
      ],
      "type": "object"
    },
    "wire.FoldMemory": {
      "description": "`memory.fold` (MAPI-13).",
      "properties": {
        "input": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.FoldInput"
            }
          ],
          "description": "Fold input."
        },
        "model_score": {
          "description": "Optional model score for the fold level; absent means deterministic.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "input"
      ],
      "type": "object"
    },
    "wire.MemoryKind": {
      "description": "Which memory store an item lives in (§34.1).",
      "oneOf": [
        {
          "description": "Working memory: session/agent scoped and budgeted.",
          "enum": [
            "working"
          ],
          "type": "string"
        },
        {
          "description": "Episodic memory: TTL and FSRS driven.",
          "enum": [
            "episodic"
          ],
          "type": "string"
        },
        {
          "description": "Semantic memory: versioned, evidence-backed facts.",
          "enum": [
            "semantic"
          ],
          "type": "string"
        },
        {
          "description": "Procedural memory: abstract procedures only, never tool grants.",
          "enum": [
            "procedural"
          ],
          "type": "string"
        }
      ]
    },
    "wire.MemoryRef": {
      "description": "Address of one memory record.",
      "properties": {
        "id": {
          "description": "Memory id.",
          "type": "string"
        },
        "kind": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.MemoryKind"
            }
          ],
          "description": "Store the id belongs to."
        },
        "revision": {
          "description": "Revision or content tag the caller observed.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "revision"
      ],
      "type": "object"
    },
    "shared.ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shared.ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "shared.Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "shared.ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "project_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "repo_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "workspace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "agent_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "session_id": {
          "$ref": "#/$defs/shared.ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "shared.RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "trace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scope": {
          "$ref": "#/$defs/shared.ScopeRef"
        },
        "principal_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "#/$defs/shared.ISODate"
        },
        "consistency": {
          "$ref": "#/$defs/shared.Consistency"
        },
        "required_generation": {
          "$ref": "#/$defs/shared.ID"
        },
        "snapshot_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "idempotency_key": {
          "$ref": "#/$defs/shared.ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    }
  }
}
