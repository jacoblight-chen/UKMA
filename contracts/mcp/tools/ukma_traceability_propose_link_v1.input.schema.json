{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/traceability.propose_link.request.schema.json",
  "title": "traceability.propose_link Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.traceability.propose_link.v1"
    },
    "context": {
      "$ref": "#/$defs/shared.RequestContext"
    },
    "input": {
      "$ref": "#/$defs/wire.ProposeLink"
    }
  },
  "$defs": {
    "wire.ProposeLink": {
      "description": "`traceability.propose_link` (TAPI-01).",
      "properties": {
        "link": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.TraceLinkInput"
            }
          ],
          "description": "Link to propose."
        }
      },
      "required": [
        "link"
      ],
      "type": "object"
    },
    "wire.TraceKind": {
      "description": "Relation kind of a link (§35.1).",
      "oneOf": [
        {
          "description": "Requirement specifies an artefact.",
          "enum": [
            "SPECIFIES"
          ],
          "type": "string"
        },
        {
          "description": "Code implements a requirement.",
          "enum": [
            "IMPLEMENTS"
          ],
          "type": "string"
        },
        {
          "description": "Test verifies an implementation.",
          "enum": [
            "VERIFIES"
          ],
          "type": "string"
        },
        {
          "description": "Plain reference.",
          "enum": [
            "REFERENCES"
          ],
          "type": "string"
        },
        {
          "description": "Explicit contradiction.",
          "enum": [
            "CONTRADICTS"
          ],
          "type": "string"
        },
        {
          "description": "Derived from another artefact.",
          "enum": [
            "DERIVED_FROM"
          ],
          "type": "string"
        }
      ]
    },
    "wire.TraceLinkInput": {
      "description": "Input of `traceability.propose_link` (§35.1).",
      "properties": {
        "evidence": {
          "description": "Evidence.",
          "items": {
            "$ref": "#/$defs/wire.TraceabilityEvidence"
          },
          "type": "array"
        },
        "kind": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.TraceKind"
            }
          ],
          "description": "Relation kind."
        },
        "rationale": {
          "description": "Optional rationale.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.TraceabilityRef"
            }
          ],
          "description": "Source endpoint."
        },
        "target": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.TraceabilityRef"
            }
          ],
          "description": "Target endpoint."
        }
      },
      "required": [
        "evidence",
        "kind",
        "source",
        "target"
      ],
      "type": "object"
    },
    "wire.TraceabilityEvidence": {
      "description": "Evidence supporting a link.",
      "properties": {
        "confidence": {
          "description": "Confidence in `[0,1]`.",
          "format": "double",
          "type": "number"
        },
        "evidence_id": {
          "description": "Evidence id.",
          "type": "string"
        },
        "source_ref": {
          "description": "Where it came from.",
          "type": "string"
        }
      },
      "required": [
        "confidence",
        "evidence_id",
        "source_ref"
      ],
      "type": "object"
    },
    "wire.TraceabilityRef": {
      "description": "Address of a trace object.",
      "properties": {
        "id": {
          "description": "Object id.",
          "type": "string"
        },
        "kind": {
          "description": "Object kind.",
          "type": "string"
        },
        "revision": {
          "description": "Observed revision.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "revision"
      ],
      "type": "object"
    },
    "shared.ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shared.ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "shared.Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "shared.ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "project_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "repo_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "workspace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "agent_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "session_id": {
          "$ref": "#/$defs/shared.ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "shared.RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "trace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scope": {
          "$ref": "#/$defs/shared.ScopeRef"
        },
        "principal_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "#/$defs/shared.ISODate"
        },
        "consistency": {
          "$ref": "#/$defs/shared.Consistency"
        },
        "required_generation": {
          "$ref": "#/$defs/shared.ID"
        },
        "snapshot_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "idempotency_key": {
          "$ref": "#/$defs/shared.ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    }
  }
}
