{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/memory.open_agent_scope.request.schema.json",
  "title": "memory.open_agent_scope Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.memory.open_agent_scope.v1"
    },
    "context": {
      "$ref": "#/$defs/shared.RequestContext"
    },
    "input": {
      "$ref": "#/$defs/wire.OpenAgentScope"
    }
  },
  "$defs": {
    "wire.AgentScopeGrant": {
      "description": "Delegation grant handed to a sub-agent (§26.4, §34.1).",
      "properties": {
        "allowed_scopes": {
          "description": "Scopes the child may use; must be a subset of the parent's.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "allowed_tools": {
          "description": "Tools the child may use; must be a subset of the parent's.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "child_agent_id": {
          "description": "Child agent instance.",
          "type": "string"
        },
        "depth": {
          "description": "Depth the child will run at.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "expires_at": {
          "description": "Expiry of the grant.",
          "type": "string"
        },
        "max_context_tokens": {
          "description": "Context tokens the child may use.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "parent_agent_id": {
          "description": "Parent agent.",
          "type": "string"
        },
        "session_id": {
          "description": "Session the grant is bound to.",
          "type": "string"
        },
        "task_id": {
          "description": "Task the child works on.",
          "type": "string"
        }
      },
      "required": [
        "allowed_scopes",
        "allowed_tools",
        "child_agent_id",
        "depth",
        "expires_at",
        "max_context_tokens",
        "parent_agent_id",
        "session_id",
        "task_id"
      ],
      "type": "object"
    },
    "wire.OpenAgentScope": {
      "description": "`memory.open_agent_scope` (MAPI-01).",
      "properties": {
        "grant": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.AgentScopeGrant"
            }
          ],
          "description": "Delegation grant."
        }
      },
      "required": [
        "grant"
      ],
      "type": "object"
    },
    "shared.ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shared.ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "shared.Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "shared.ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "project_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "repo_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "workspace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "agent_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "session_id": {
          "$ref": "#/$defs/shared.ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "shared.RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "trace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scope": {
          "$ref": "#/$defs/shared.ScopeRef"
        },
        "principal_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "#/$defs/shared.ISODate"
        },
        "consistency": {
          "$ref": "#/$defs/shared.Consistency"
        },
        "required_generation": {
          "$ref": "#/$defs/shared.ID"
        },
        "snapshot_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "idempotency_key": {
          "$ref": "#/$defs/shared.ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    }
  }
}
