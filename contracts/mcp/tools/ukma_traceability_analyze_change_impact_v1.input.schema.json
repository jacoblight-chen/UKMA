{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/traceability.analyze_change_impact.request.schema.json",
  "title": "traceability.analyze_change_impact Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.traceability.analyze_change_impact.v1"
    },
    "context": {
      "$ref": "#/$defs/shared.RequestContext"
    },
    "input": {
      "$ref": "#/$defs/wire.TraceImpactQuery"
    }
  },
  "$defs": {
    "wire.TraceImpactQuery": {
      "description": "`traceability.analyze_change_impact` (TAPI-08, \u00a735.1 `TraceImpactQuery`).",
      "properties": {
        "changed": {
          "description": "Changed endpoints.",
          "items": {
            "$ref": "#/$defs/wire.TraceabilityRef"
          },
          "type": "array"
        },
        "kinds": {
          "description": "Kinds to follow; empty means all.",
          "items": {
            "$ref": "#/$defs/wire.TraceKind"
          },
          "type": "array"
        },
        "max_depth": {
          "description": "Maximum traversal depth.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "page": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.TraceabilityPageRequest"
            }
          ],
          "description": "Page request for the returned links."
        }
      },
      "required": [
        "changed",
        "kinds",
        "max_depth",
        "page"
      ],
      "type": "object"
    },
    "wire.TraceKind": {
      "description": "Relation kind of a link (\u00a735.1).",
      "oneOf": [
        {
          "description": "Requirement specifies an artefact.",
          "enum": [
            "SPECIFIES"
          ],
          "type": "string"
        },
        {
          "description": "Code implements a requirement.",
          "enum": [
            "IMPLEMENTS"
          ],
          "type": "string"
        },
        {
          "description": "Test verifies an implementation.",
          "enum": [
            "VERIFIES"
          ],
          "type": "string"
        },
        {
          "description": "Plain reference.",
          "enum": [
            "REFERENCES"
          ],
          "type": "string"
        },
        {
          "description": "Explicit contradiction.",
          "enum": [
            "CONTRADICTS"
          ],
          "type": "string"
        },
        {
          "description": "Derived from another artefact.",
          "enum": [
            "DERIVED_FROM"
          ],
          "type": "string"
        }
      ]
    },
    "wire.TraceabilityPageRequest": {
      "description": "Cursor page request (\u00a731.4).",
      "properties": {
        "cursor": {
          "description": "Opaque cursor.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "description": "Maximum items.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "limit"
      ],
      "type": "object"
    },
    "wire.TraceabilityRef": {
      "description": "Address of a trace object.",
      "properties": {
        "id": {
          "description": "Object id.",
          "type": "string"
        },
        "kind": {
          "description": "Object kind.",
          "type": "string"
        },
        "revision": {
          "description": "Observed revision.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "revision"
      ],
      "type": "object"
    },
    "shared.ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shared.ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "shared.Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "shared.ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "project_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "repo_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "workspace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "agent_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "session_id": {
          "$ref": "#/$defs/shared.ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "shared.RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "trace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scope": {
          "$ref": "#/$defs/shared.ScopeRef"
        },
        "principal_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "#/$defs/shared.ISODate"
        },
        "consistency": {
          "$ref": "#/$defs/shared.Consistency"
        },
        "required_generation": {
          "$ref": "#/$defs/shared.ID"
        },
        "snapshot_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "idempotency_key": {
          "$ref": "#/$defs/shared.ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    }
  }
}
