{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/memory.search.request.schema.json",
  "title": "memory.search Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.memory.search.v1"
    },
    "context": {
      "$ref": "#/$defs/shared.RequestContext"
    },
    "input": {
      "$ref": "#/$defs/wire.SearchMemory"
    }
  },
  "$defs": {
    "wire.DetailLevel": {
      "description": "Requested response detail (§34.1 `MemoryQuery.detail`).",
      "oneOf": [
        {
          "description": "Identification only.",
          "enum": [
            "title"
          ],
          "type": "string"
        },
        {
          "description": "Key facts only.",
          "enum": [
            "facts"
          ],
          "type": "string"
        },
        {
          "description": "Summary plus evidence references.",
          "enum": [
            "summary"
          ],
          "type": "string"
        },
        {
          "description": "Full authorised content.",
          "enum": [
            "full"
          ],
          "type": "string"
        }
      ]
    },
    "wire.MemoryKind": {
      "description": "Which memory store an item lives in (§34.1).",
      "oneOf": [
        {
          "description": "Working memory: session/agent scoped and budgeted.",
          "enum": [
            "working"
          ],
          "type": "string"
        },
        {
          "description": "Episodic memory: TTL and FSRS driven.",
          "enum": [
            "episodic"
          ],
          "type": "string"
        },
        {
          "description": "Semantic memory: versioned, evidence-backed facts.",
          "enum": [
            "semantic"
          ],
          "type": "string"
        },
        {
          "description": "Procedural memory: abstract procedures only, never tool grants.",
          "enum": [
            "procedural"
          ],
          "type": "string"
        }
      ]
    },
    "wire.MemoryQuery": {
      "description": "Search request (§34.1 `MemoryQuery`).",
      "properties": {
        "after": {
          "description": "Only records created at or after this instant.",
          "type": [
            "string",
            "null"
          ]
        },
        "before": {
          "description": "Only records created at or before this instant.",
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.DetailLevel"
            }
          ],
          "description": "Requested detail."
        },
        "kinds": {
          "description": "Stores to search.",
          "items": {
            "$ref": "#/$defs/wire.MemoryKind"
          },
          "type": "array"
        },
        "language": {
          "description": "Optional language filter (BCP-47).",
          "type": [
            "string",
            "null"
          ]
        },
        "max_results": {
          "description": "Maximum number of results.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "max_tokens": {
          "description": "Token budget for the response.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "min_trust": {
          "description": "Minimum ranking trust, in `[0,1]`.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "query": {
          "description": "Free-text query.",
          "type": "string"
        }
      },
      "required": [
        "detail",
        "kinds",
        "max_results",
        "max_tokens",
        "query"
      ],
      "type": "object"
    },
    "wire.SearchMemory": {
      "description": "`memory.search` (MAPI-07).",
      "properties": {
        "query": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.MemoryQuery"
            }
          ],
          "description": "Query."
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "shared.ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shared.ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "shared.Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "shared.ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "project_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "repo_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "workspace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "agent_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "session_id": {
          "$ref": "#/$defs/shared.ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "shared.RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "trace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scope": {
          "$ref": "#/$defs/shared.ScopeRef"
        },
        "principal_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "#/$defs/shared.ISODate"
        },
        "consistency": {
          "$ref": "#/$defs/shared.Consistency"
        },
        "required_generation": {
          "$ref": "#/$defs/shared.ID"
        },
        "snapshot_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "idempotency_key": {
          "$ref": "#/$defs/shared.ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    }
  }
}
