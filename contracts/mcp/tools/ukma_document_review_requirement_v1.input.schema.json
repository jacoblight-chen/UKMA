{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/document.review_requirement.request.schema.json",
  "title": "document.review_requirement Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.document.review_requirement.v1"
    },
    "context": {
      "$ref": "#/$defs/shared.RequestContext"
    },
    "input": {
      "$ref": "#/$defs/wire.ReviewRequirement"
    }
  },
  "$defs": {
    "wire.ReviewDecision": {
      "description": "Review decision.",
      "oneOf": [
        {
          "description": "Accept the candidate.",
          "enum": [
            "approve"
          ],
          "type": "string"
        },
        {
          "description": "Reject the candidate.",
          "enum": [
            "reject"
          ],
          "type": "string"
        }
      ]
    },
    "wire.ReviewRequirement": {
      "description": "`document.review_requirement` (DAPI-09).",
      "properties": {
        "candidate_id": {
          "description": "Candidate id.",
          "type": "string"
        },
        "decision": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.ReviewDecision"
            }
          ],
          "description": "`approve` or `reject`."
        },
        "evidence_ids": {
          "description": "Evidence supporting the decision; empty means the review is rejected.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expected_etag": {
          "description": "Candidate etag for optimistic concurrency.",
          "type": "string"
        },
        "rationale": {
          "description": "Reviewer rationale.",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "decision",
        "evidence_ids",
        "expected_etag",
        "rationale"
      ],
      "type": "object"
    },
    "shared.ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shared.ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "shared.Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "shared.ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "project_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "repo_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "workspace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "agent_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "session_id": {
          "$ref": "#/$defs/shared.ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "shared.RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "trace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scope": {
          "$ref": "#/$defs/shared.ScopeRef"
        },
        "principal_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "#/$defs/shared.ISODate"
        },
        "consistency": {
          "$ref": "#/$defs/shared.Consistency"
        },
        "required_generation": {
          "$ref": "#/$defs/shared.ID"
        },
        "snapshot_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "idempotency_key": {
          "$ref": "#/$defs/shared.ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    }
  }
}
