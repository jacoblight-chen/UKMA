{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/code.query_callees.request.schema.json",
  "title": "code.query_callees Request (Phase 4 typed candidate)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.code.query_callees.v1"
    },
    "context": {
      "$ref": "#/$defs/shared.RequestContext"
    },
    "input": {
      "$ref": "#/$defs/wire.TraversalQuery"
    }
  },
  "$defs": {
    "wire.CodeEdgeKind": {
      "description": "Edge kind (\u00a732.1 `CodeEdge.kind`).",
      "oneOf": [
        {
          "description": "Function call.",
          "enum": [
            "calls"
          ],
          "type": "string"
        },
        {
          "description": "Import.",
          "enum": [
            "imports"
          ],
          "type": "string"
        },
        {
          "description": "Dependency.",
          "enum": [
            "depends_on"
          ],
          "type": "string"
        },
        {
          "description": "Implements a trait/interface.",
          "enum": [
            "implements"
          ],
          "type": "string"
        },
        {
          "description": "Generic reference.",
          "enum": [
            "references"
          ],
          "type": "string"
        },
        {
          "description": "Defines.",
          "enum": [
            "defines"
          ],
          "type": "string"
        }
      ]
    },
    "wire.CodePageRequest": {
      "description": "A page request (\u00a731.4). `limit` is bounded; `cursor` is opaque.",
      "properties": {
        "cursor": {
          "description": "Opaque cursor from a previous page.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "description": "Maximum items to return (1..=200).",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "limit"
      ],
      "type": "object"
    },
    "wire.Direction": {
      "description": "Direction of a traversal (`\u00a732.1 TraversalQuery.direction`).",
      "oneOf": [
        {
          "description": "Callers / incoming edges.",
          "enum": [
            "in"
          ],
          "type": "string"
        },
        {
          "description": "Callees / outgoing edges.",
          "enum": [
            "out"
          ],
          "type": "string"
        }
      ]
    },
    "wire.TraversalQuery": {
      "description": "Request: bounded traversal of the code graph (`CAPI-07/08/09`).",
      "properties": {
        "direction": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.Direction"
            }
          ],
          "description": "Direction."
        },
        "edge_kinds": {
          "description": "Edge kinds to follow (empty means every kind).",
          "items": {
            "$ref": "#/$defs/wire.CodeEdgeKind"
          },
          "type": "array"
        },
        "max_depth": {
          "description": "Maximum hops.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "max_nodes": {
          "description": "Maximum visited nodes.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "page": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.CodePageRequest"
            }
          ],
          "description": "Page over the collected edges."
        },
        "symbol_id": {
          "description": "Start symbol.",
          "type": "string"
        }
      },
      "required": [
        "direction",
        "edge_kinds",
        "max_depth",
        "max_nodes",
        "page",
        "symbol_id"
      ],
      "type": "object"
    },
    "shared.ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shared.ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "shared.Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "shared.ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "project_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "repo_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "workspace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "agent_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "session_id": {
          "$ref": "#/$defs/shared.ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "shared.RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "trace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scope": {
          "$ref": "#/$defs/shared.ScopeRef"
        },
        "principal_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "#/$defs/shared.ISODate"
        },
        "consistency": {
          "$ref": "#/$defs/shared.Consistency"
        },
        "required_generation": {
          "$ref": "#/$defs/shared.ID"
        },
        "snapshot_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "idempotency_key": {
          "$ref": "#/$defs/shared.ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    }
  }
}
