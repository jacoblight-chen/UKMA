{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/traceability.revalidate_stale.request.schema.json",
  "title": "traceability.revalidate_stale Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.traceability.revalidate_stale.v1"
    },
    "context": {
      "$ref": "#/$defs/shared.RequestContext"
    },
    "input": {
      "$ref": "#/$defs/wire.RevalidateStale"
    }
  },
  "$defs": {
    "wire.RevalidateStale": {
      "description": "`traceability.revalidate_stale` (TAPI-12).",
      "properties": {
        "asynchronous": {
          "description": "Must be `true`: revalidation is asynchronous (§35.2).",
          "type": "boolean"
        },
        "link_refs": {
          "description": "Links to revalidate.",
          "items": {
            "$ref": "#/$defs/wire.TraceabilityRef"
          },
          "type": "array"
        },
        "policy_id": {
          "description": "Policy that authorises the revalidation.",
          "type": "string"
        }
      },
      "required": [
        "asynchronous",
        "link_refs",
        "policy_id"
      ],
      "type": "object"
    },
    "wire.TraceabilityRef": {
      "description": "Address of a trace object.",
      "properties": {
        "id": {
          "description": "Object id.",
          "type": "string"
        },
        "kind": {
          "description": "Object kind.",
          "type": "string"
        },
        "revision": {
          "description": "Observed revision.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "revision"
      ],
      "type": "object"
    },
    "shared.ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shared.ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "shared.Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "shared.ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "project_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "repo_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "workspace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "agent_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "session_id": {
          "$ref": "#/$defs/shared.ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "shared.RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "trace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scope": {
          "$ref": "#/$defs/shared.ScopeRef"
        },
        "principal_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "#/$defs/shared.ISODate"
        },
        "consistency": {
          "$ref": "#/$defs/shared.Consistency"
        },
        "required_generation": {
          "$ref": "#/$defs/shared.ID"
        },
        "snapshot_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "idempotency_key": {
          "$ref": "#/$defs/shared.ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    }
  }
}
