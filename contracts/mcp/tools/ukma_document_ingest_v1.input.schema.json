{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/document.ingest.request.schema.json",
  "title": "document.ingest Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.document.ingest.v1"
    },
    "context": {
      "$ref": "#/$defs/shared.RequestContext"
    },
    "input": {
      "$ref": "#/$defs/wire.DocumentIngest"
    }
  },
  "$defs": {
    "wire.DocumentIngest": {
      "description": "`document.ingest` (DAPI-01).",
      "properties": {
        "asynchronous": {
          "description": "Must be `true`; a synchronous contract would hide job state.",
          "type": "boolean"
        },
        "include_images": {
          "description": "Include images (they stay unparsed without OCR).",
          "type": "boolean"
        },
        "parser_profile": {
          "description": "Parser profile the caller requires.",
          "type": "string"
        },
        "source": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.DocumentSource"
            }
          ],
          "description": "Source description."
        }
      },
      "required": [
        "asynchronous",
        "include_images",
        "parser_profile",
        "source"
      ],
      "type": "object"
    },
    "wire.DocumentSource": {
      "description": "Where a document came from (`§33.1 DocumentSource`).",
      "properties": {
        "artifact_ref": {
          "description": "Artifact reference.",
          "type": "string"
        },
        "content_hash": {
          "description": "`sha256:<hex>` of the artifact bytes.",
          "type": "string"
        },
        "language_hint": {
          "description": "Language hint used by the parser.",
          "type": [
            "string",
            "null"
          ]
        },
        "media_type": {
          "description": "Media type of the artifact.",
          "type": "string"
        },
        "revision": {
          "description": "Caller-provided revision label.",
          "type": "string"
        },
        "source_uri": {
          "description": "Original URI (informational; the artifact is the authority).",
          "type": "string"
        }
      },
      "required": [
        "artifact_ref",
        "content_hash",
        "media_type",
        "revision",
        "source_uri"
      ],
      "type": "object"
    },
    "shared.ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shared.ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "shared.Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "shared.ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "project_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "repo_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "workspace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "agent_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "session_id": {
          "$ref": "#/$defs/shared.ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "shared.RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "trace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scope": {
          "$ref": "#/$defs/shared.ScopeRef"
        },
        "principal_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "#/$defs/shared.ISODate"
        },
        "consistency": {
          "$ref": "#/$defs/shared.Consistency"
        },
        "required_generation": {
          "$ref": "#/$defs/shared.ID"
        },
        "snapshot_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "idempotency_key": {
          "$ref": "#/$defs/shared.ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    }
  }
}
