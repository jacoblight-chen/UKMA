{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/memory.store_episode.request.schema.json",
  "title": "memory.store_episode Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.memory.store_episode.v1"
    },
    "context": {
      "$ref": "#/$defs/shared.RequestContext"
    },
    "input": {
      "$ref": "#/$defs/wire.StoreEpisode"
    }
  },
  "$defs": {
    "wire.EpisodeInput": {
      "description": "Input of `memory.store_episode` (§34.1).",
      "properties": {
        "agent_depth": {
          "description": "Delegation depth of the writing agent.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "agent_id": {
          "description": "Agent id.",
          "type": "string"
        },
        "episode_type": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.EpisodeType"
            }
          ],
          "description": "Episode type."
        },
        "evidence": {
          "description": "Evidence supporting the episode.",
          "items": {
            "$ref": "#/$defs/wire.MemoryEvidence"
          },
          "type": "array"
        },
        "full_text_ref": {
          "description": "Reference to the full text artifact, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "importance_score": {
          "description": "Importance in `[0,1]`.",
          "format": "double",
          "type": "number"
        },
        "key_facts": {
          "description": "Key facts.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "language": {
          "description": "BCP-47 language.",
          "type": "string"
        },
        "outcome": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.EpisodeOutcome"
            }
          ],
          "description": "Outcome."
        },
        "session_id": {
          "description": "Session id.",
          "type": "string"
        },
        "source_refs": {
          "description": "Sources the episode derives from.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "summary": {
          "description": "Summary text.",
          "type": "string"
        }
      },
      "required": [
        "agent_depth",
        "agent_id",
        "episode_type",
        "evidence",
        "importance_score",
        "key_facts",
        "language",
        "outcome",
        "session_id",
        "source_refs",
        "summary"
      ],
      "type": "object"
    },
    "wire.EpisodeOutcome": {
      "description": "Outcome of the work an episode records (§21.3).",
      "oneOf": [
        {
          "description": "Finished successfully.",
          "enum": [
            "success"
          ],
          "type": "string"
        },
        {
          "description": "Partially finished.",
          "enum": [
            "partial"
          ],
          "type": "string"
        },
        {
          "description": "Failed.",
          "enum": [
            "failure"
          ],
          "type": "string"
        }
      ]
    },
    "wire.EpisodeType": {
      "description": "Episode type (§21.3).",
      "oneOf": [
        {
          "description": "One conversation turn.",
          "enum": [
            "conversation_turn"
          ],
          "type": "string"
        },
        {
          "description": "One tool execution.",
          "enum": [
            "tool_execution"
          ],
          "type": "string"
        },
        {
          "description": "A reflection episode.",
          "enum": [
            "reflection"
          ],
          "type": "string"
        },
        {
          "description": "An episode synthesised from a sub-agent.",
          "enum": [
            "folded_subagent"
          ],
          "type": "string"
        }
      ]
    },
    "wire.MemoryEvidence": {
      "description": "Evidence supporting a claim (§21.1 `provenance_refs`, §34.1).",
      "properties": {
        "confidence": {
          "description": "Confidence the extractor assigned to this piece of evidence.",
          "format": "double",
          "type": "number"
        },
        "evidence_id": {
          "description": "Evidence id.",
          "type": "string"
        },
        "source_group": {
          "description": "Independent source group used for promotion counting (§27.1).",
          "type": "string"
        },
        "source_ref": {
          "description": "Where the evidence came from, for example `artifact:sha256:...`.",
          "type": "string"
        }
      },
      "required": [
        "confidence",
        "evidence_id",
        "source_group",
        "source_ref"
      ],
      "type": "object"
    },
    "wire.StoreEpisode": {
      "description": "`memory.store_episode` (MAPI-06).",
      "properties": {
        "input": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.EpisodeInput"
            }
          ],
          "description": "Episode to store."
        }
      },
      "required": [
        "input"
      ],
      "type": "object"
    },
    "shared.ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shared.ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "shared.Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "shared.ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "project_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "repo_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "workspace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "agent_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "session_id": {
          "$ref": "#/$defs/shared.ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "shared.RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "trace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scope": {
          "$ref": "#/$defs/shared.ScopeRef"
        },
        "principal_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "#/$defs/shared.ISODate"
        },
        "consistency": {
          "$ref": "#/$defs/shared.Consistency"
        },
        "required_generation": {
          "$ref": "#/$defs/shared.ID"
        },
        "snapshot_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "idempotency_key": {
          "$ref": "#/$defs/shared.ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    }
  }
}
