{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/memory.commit_reconsolidation.request.schema.json",
  "title": "memory.commit_reconsolidation Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.memory.commit_reconsolidation.v1"
    },
    "context": {
      "$ref": "#/$defs/shared.RequestContext"
    },
    "input": {
      "$ref": "#/$defs/wire.CommitReconsolidation"
    }
  },
  "$defs": {
    "wire.CommitReconsolidation": {
      "description": "`memory.commit_reconsolidation` (MAPI-17).",
      "properties": {
        "evidence": {
          "description": "Evidence supporting the change.",
          "items": {
            "$ref": "#/$defs/wire.MemoryEvidence"
          },
          "type": "array"
        },
        "expected_etag": {
          "description": "Caller's etag.",
          "type": "string"
        },
        "patch": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.MemoryPatch"
            }
          ],
          "description": "Patch to apply."
        },
        "window_id": {
          "description": "Window to commit.",
          "type": "string"
        }
      },
      "required": [
        "evidence",
        "expected_etag",
        "patch",
        "window_id"
      ],
      "type": "object"
    },
    "wire.MemoryEvidence": {
      "description": "Evidence supporting a claim (§21.1 `provenance_refs`, §34.1).",
      "properties": {
        "confidence": {
          "description": "Confidence the extractor assigned to this piece of evidence.",
          "format": "double",
          "type": "number"
        },
        "evidence_id": {
          "description": "Evidence id.",
          "type": "string"
        },
        "source_group": {
          "description": "Independent source group used for promotion counting (§27.1).",
          "type": "string"
        },
        "source_ref": {
          "description": "Where the evidence came from, for example `artifact:sha256:...`.",
          "type": "string"
        }
      },
      "required": [
        "confidence",
        "evidence_id",
        "source_group",
        "source_ref"
      ],
      "type": "object"
    },
    "wire.MemoryPatch": {
      "description": "Patch applied by `memory.update_revision` / `commit_reconsolidation`.",
      "properties": {
        "content": {
          "description": "Replacement body.",
          "type": [
            "string",
            "null"
          ]
        },
        "importance_score": {
          "description": "Replacement importance.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "key_facts": {
          "description": "Replacement key facts.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "language": {
          "description": "Replacement language.",
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "description": "Replacement summary.",
          "type": [
            "string",
            "null"
          ]
        },
        "trust": {
          "anyOf": [
            {
              "$ref": "#/$defs/wire.Trust"
            },
            {
              "type": "null"
            }
          ],
          "description": "Replacement trust columns."
        }
      },
      "type": "object"
    },
    "wire.Trust": {
      "description": "Trust columns of a memory object (§21.1, kept separate from authorization).",
      "properties": {
        "agent": {
          "description": "Confidence attributed to the indirect agent.",
          "format": "double",
          "type": "number"
        },
        "extraction": {
          "description": "Confidence of the extractor that produced the record.",
          "format": "double",
          "type": "number"
        },
        "source": {
          "description": "Reliability of the asserting source.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "agent",
        "extraction",
        "source"
      ],
      "type": "object"
    },
    "shared.ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shared.ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "shared.Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "shared.ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "project_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "repo_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "workspace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "agent_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "session_id": {
          "$ref": "#/$defs/shared.ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "shared.RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "trace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scope": {
          "$ref": "#/$defs/shared.ScopeRef"
        },
        "principal_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "#/$defs/shared.ISODate"
        },
        "consistency": {
          "$ref": "#/$defs/shared.Consistency"
        },
        "required_generation": {
          "$ref": "#/$defs/shared.ID"
        },
        "snapshot_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "idempotency_key": {
          "$ref": "#/$defs/shared.ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    }
  }
}
