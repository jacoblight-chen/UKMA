{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/memory.record_procedure_outcome.request.schema.json",
  "title": "memory.record_procedure_outcome Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.memory.record_procedure_outcome.v1"
    },
    "context": {
      "$ref": "#/$defs/shared.RequestContext"
    },
    "input": {
      "$ref": "#/$defs/wire.RecordProcedureOutcome"
    }
  },
  "$defs": {
    "wire.MemoryEvidence": {
      "description": "Evidence supporting a claim (§21.1 `provenance_refs`, §34.1).",
      "properties": {
        "confidence": {
          "description": "Confidence the extractor assigned to this piece of evidence.",
          "format": "double",
          "type": "number"
        },
        "evidence_id": {
          "description": "Evidence id.",
          "type": "string"
        },
        "source_group": {
          "description": "Independent source group used for promotion counting (§27.1).",
          "type": "string"
        },
        "source_ref": {
          "description": "Where the evidence came from, for example `artifact:sha256:...`.",
          "type": "string"
        }
      },
      "required": [
        "confidence",
        "evidence_id",
        "source_group",
        "source_ref"
      ],
      "type": "object"
    },
    "wire.MemoryKind": {
      "description": "Which memory store an item lives in (§34.1).",
      "oneOf": [
        {
          "description": "Working memory: session/agent scoped and budgeted.",
          "enum": [
            "working"
          ],
          "type": "string"
        },
        {
          "description": "Episodic memory: TTL and FSRS driven.",
          "enum": [
            "episodic"
          ],
          "type": "string"
        },
        {
          "description": "Semantic memory: versioned, evidence-backed facts.",
          "enum": [
            "semantic"
          ],
          "type": "string"
        },
        {
          "description": "Procedural memory: abstract procedures only, never tool grants.",
          "enum": [
            "procedural"
          ],
          "type": "string"
        }
      ]
    },
    "wire.MemoryRef": {
      "description": "Address of one memory record.",
      "properties": {
        "id": {
          "description": "Memory id.",
          "type": "string"
        },
        "kind": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.MemoryKind"
            }
          ],
          "description": "Store the id belongs to."
        },
        "revision": {
          "description": "Revision or content tag the caller observed.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "revision"
      ],
      "type": "object"
    },
    "wire.RecordProcedureOutcome": {
      "description": "`memory.record_procedure_outcome` (MAPI-22 — implemented in P6).",
      "properties": {
        "evidence": {
          "description": "Evidence of the run.",
          "items": {
            "$ref": "#/$defs/wire.MemoryEvidence"
          },
          "type": "array"
        },
        "expected_etag": {
          "description": "Caller's etag.",
          "type": "string"
        },
        "procedure": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.MemoryRef"
            }
          ],
          "description": "Procedure that ran."
        },
        "success": {
          "description": "Whether the run succeeded.",
          "type": "boolean"
        }
      },
      "required": [
        "evidence",
        "expected_etag",
        "procedure",
        "success"
      ],
      "type": "object"
    },
    "shared.ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shared.ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "shared.Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "shared.ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "project_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "repo_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "workspace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "agent_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "session_id": {
          "$ref": "#/$defs/shared.ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "shared.RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "trace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scope": {
          "$ref": "#/$defs/shared.ScopeRef"
        },
        "principal_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "#/$defs/shared.ISODate"
        },
        "consistency": {
          "$ref": "#/$defs/shared.Consistency"
        },
        "required_generation": {
          "$ref": "#/$defs/shared.ID"
        },
        "snapshot_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "idempotency_key": {
          "$ref": "#/$defs/shared.ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    }
  }
}
