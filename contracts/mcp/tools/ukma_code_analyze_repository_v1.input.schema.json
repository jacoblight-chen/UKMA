{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/code.analyze_repository.request.schema.json",
  "title": "code.analyze_repository Request (Phase 4 typed candidate)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.code.analyze_repository.v1"
    },
    "context": {
      "$ref": "#/$defs/shared.RequestContext"
    },
    "input": {
      "$ref": "#/$defs/wire.AnalyzeRepository"
    }
  },
  "$defs": {
    "wire.AnalyzeRepository": {
      "description": "Request: start (or join) a repository analysis (`CAPI-01`).",
      "properties": {
        "asynchronous": {
          "description": "Callers must pass `true`; a synchronous contract would hide job state.",
          "type": "boolean"
        },
        "exclude_globs": {
          "description": "Exclude globs.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "include_globs": {
          "description": "Include globs (empty means \"everything the parser supports\").",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "parser_profile": {
          "description": "Parser profile the caller requires.",
          "type": "string"
        },
        "revision": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.RepoRevision"
            }
          ],
          "description": "Revision to analyze."
        }
      },
      "required": [
        "asynchronous",
        "exclude_globs",
        "include_globs",
        "parser_profile",
        "revision"
      ],
      "type": "object"
    },
    "wire.DirtyPolicy": {
      "description": "Dirty-worktree handling (\u00a732.1 `dirty_policy`).",
      "oneOf": [
        {
          "description": "Refuse to analyze a dirty worktree.",
          "enum": [
            "reject"
          ],
          "type": "string"
        },
        {
          "description": "Analyze the dirty content and record it as a snapshot.",
          "enum": [
            "snapshot"
          ],
          "type": "string"
        }
      ]
    },
    "wire.RepoRevision": {
      "description": "Which revision of a repository a request is bound to (`\u00a732.1 RepoRevision`).",
      "properties": {
        "commit_sha": {
          "description": "Full commit SHA the request is bound to.",
          "type": "string"
        },
        "dirty_policy": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.DirtyPolicy"
            }
          ],
          "description": "What to do when the worktree is dirty."
        },
        "repository_id": {
          "description": "Repository resource id.",
          "type": "string"
        },
        "tree_sha": {
          "description": "Optional tree SHA.",
          "type": [
            "string",
            "null"
          ]
        },
        "vcs": {
          "description": "Version control system; only `git` is supported today.",
          "type": "string"
        }
      },
      "required": [
        "commit_sha",
        "dirty_policy",
        "repository_id",
        "vcs"
      ],
      "type": "object"
    },
    "shared.ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shared.ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "shared.Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "shared.ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "project_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "repo_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "workspace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "agent_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "session_id": {
          "$ref": "#/$defs/shared.ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "shared.RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "trace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scope": {
          "$ref": "#/$defs/shared.ScopeRef"
        },
        "principal_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "#/$defs/shared.ISODate"
        },
        "consistency": {
          "$ref": "#/$defs/shared.Consistency"
        },
        "required_generation": {
          "$ref": "#/$defs/shared.ID"
        },
        "snapshot_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "idempotency_key": {
          "$ref": "#/$defs/shared.ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    }
  }
}
