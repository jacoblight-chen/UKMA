{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/memory.list.request.schema.json",
  "title": "memory.list Request (Phase 4 typed candidate)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.memory.list.v1"
    },
    "context": {
      "$ref": "#/$defs/shared.RequestContext"
    },
    "input": {
      "$ref": "#/$defs/wire.ListMemoryQuery"
    }
  },
  "$defs": {
    "wire.ListMemoryQuery": {
      "description": "`memory.list` request: live records, optionally per store, cursor-paged.",
      "properties": {
        "kinds": {
          "description": "Stores to list; empty means all stores.",
          "items": {
            "$ref": "#/$defs/wire.MemoryKind"
          },
          "type": "array"
        },
        "page": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.MemoryPageRequest"
            }
          ],
          "description": "Cursor page."
        }
      },
      "required": [
        "kinds",
        "page"
      ],
      "type": "object"
    },
    "wire.MemoryKind": {
      "description": "Which memory store an item lives in (§34.1).",
      "oneOf": [
        {
          "description": "Working memory: session/agent scoped and budgeted.",
          "enum": [
            "working"
          ],
          "type": "string"
        },
        {
          "description": "Episodic memory: TTL and FSRS driven.",
          "enum": [
            "episodic"
          ],
          "type": "string"
        },
        {
          "description": "Semantic memory: versioned, evidence-backed facts.",
          "enum": [
            "semantic"
          ],
          "type": "string"
        },
        {
          "description": "Procedural memory: abstract procedures only, never tool grants.",
          "enum": [
            "procedural"
          ],
          "type": "string"
        }
      ]
    },
    "wire.MemoryPageRequest": {
      "description": "Cursor page request (§31.4).",
      "properties": {
        "cursor": {
          "description": "Opaque cursor.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "description": "Maximum items.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "limit"
      ],
      "type": "object"
    },
    "shared.ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shared.ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "shared.Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "shared.ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "project_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "repo_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "workspace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "agent_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "session_id": {
          "$ref": "#/$defs/shared.ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "shared.RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "trace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scope": {
          "$ref": "#/$defs/shared.ScopeRef"
        },
        "principal_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "#/$defs/shared.ISODate"
        },
        "consistency": {
          "$ref": "#/$defs/shared.Consistency"
        },
        "required_generation": {
          "$ref": "#/$defs/shared.ID"
        },
        "snapshot_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "idempotency_key": {
          "$ref": "#/$defs/shared.ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    }
  }
}
