{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/traceability.compare_revisions.request.schema.json",
  "title": "traceability.compare_revisions Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.traceability.compare_revisions.v1"
    },
    "context": {
      "$ref": "#/$defs/shared.RequestContext"
    },
    "input": {
      "$ref": "#/$defs/wire.TraceRevisionDiff"
    }
  },
  "$defs": {
    "wire.ScopeRef": {
      "description": "Tenant/project scope, kept local so the crate has no wire dependency.",
      "properties": {
        "project_id": {
          "description": "Project.",
          "type": "string"
        },
        "tenant_id": {
          "description": "Tenant.",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "tenant_id"
      ],
      "type": "object"
    },
    "wire.TraceRevisionDiff": {
      "description": "`traceability.compare_revisions` (TAPI-10).",
      "properties": {
        "from_revision": {
          "description": "Baseline snapshot.",
          "type": "string"
        },
        "scope": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.ScopeRef"
            }
          ],
          "description": "Tenant/project scope."
        },
        "to_revision": {
          "description": "Comparison snapshot.",
          "type": "string"
        }
      },
      "required": [
        "from_revision",
        "scope",
        "to_revision"
      ],
      "type": "object"
    },
    "shared.ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shared.ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "shared.Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "shared.ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "project_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "repo_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "workspace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "agent_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "session_id": {
          "$ref": "#/$defs/shared.ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "shared.RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "trace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scope": {
          "$ref": "#/$defs/shared.ScopeRef"
        },
        "principal_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "#/$defs/shared.ISODate"
        },
        "consistency": {
          "$ref": "#/$defs/shared.Consistency"
        },
        "required_generation": {
          "$ref": "#/$defs/shared.ID"
        },
        "snapshot_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "idempotency_key": {
          "$ref": "#/$defs/shared.ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    }
  }
}
