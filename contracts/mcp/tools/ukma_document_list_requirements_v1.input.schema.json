{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/document.list_requirements.request.schema.json",
  "title": "document.list_requirements Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.document.list_requirements.v1"
    },
    "context": {
      "$ref": "#/$defs/shared.RequestContext"
    },
    "input": {
      "$ref": "#/$defs/wire.ListRequirements"
    }
  },
  "$defs": {
    "wire.DocumentPageRequest": {
      "description": "Page request (\u00a731.4). Kept local so the crate has no wire dependency.",
      "properties": {
        "cursor": {
          "description": "Opaque cursor.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "description": "Maximum items.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "limit"
      ],
      "type": "object"
    },
    "wire.ListRequirements": {
      "description": "`document.list_requirements` (DAPI-10).",
      "properties": {
        "document_id": {
          "description": "Document id.",
          "type": "string"
        },
        "page": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.DocumentPageRequest"
            }
          ],
          "description": "Page."
        },
        "statuses": {
          "description": "Restrict to these statuses.",
          "items": {
            "$ref": "#/$defs/wire.RequirementStatus"
          },
          "type": "array"
        }
      },
      "required": [
        "document_id",
        "page",
        "statuses"
      ],
      "type": "object"
    },
    "wire.RequirementStatus": {
      "description": "Lifecycle of a requirement candidate (`\u00a733.1 status`).",
      "oneOf": [
        {
          "description": "Proposed by an extractor; never authoritative.",
          "enum": [
            "candidate"
          ],
          "type": "string"
        },
        {
          "description": "Accepted by a reviewer.",
          "enum": [
            "approved"
          ],
          "type": "string"
        },
        {
          "description": "Rejected by a reviewer.",
          "enum": [
            "rejected"
          ],
          "type": "string"
        },
        {
          "description": "Replaced by a newer revision.",
          "enum": [
            "superseded"
          ],
          "type": "string"
        }
      ]
    },
    "shared.ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shared.ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "shared.Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "shared.ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "project_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "repo_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "workspace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "agent_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "session_id": {
          "$ref": "#/$defs/shared.ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "shared.RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "trace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scope": {
          "$ref": "#/$defs/shared.ScopeRef"
        },
        "principal_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "#/$defs/shared.ISODate"
        },
        "consistency": {
          "$ref": "#/$defs/shared.Consistency"
        },
        "required_generation": {
          "$ref": "#/$defs/shared.ID"
        },
        "snapshot_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "idempotency_key": {
          "$ref": "#/$defs/shared.ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    }
  }
}
