{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/code.analyze_impact.request.schema.json",
  "title": "code.analyze_impact Request (Phase 4 typed candidate)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.code.analyze_impact.v1"
    },
    "context": {
      "$ref": "#/$defs/shared.RequestContext"
    },
    "input": {
      "$ref": "#/$defs/wire.ImpactQuery"
    }
  },
  "$defs": {
    "wire.CodeEdgeKind": {
      "description": "Edge kind (§32.1 `CodeEdge.kind`).",
      "oneOf": [
        {
          "description": "Function call.",
          "enum": [
            "calls"
          ],
          "type": "string"
        },
        {
          "description": "Import.",
          "enum": [
            "imports"
          ],
          "type": "string"
        },
        {
          "description": "Dependency.",
          "enum": [
            "depends_on"
          ],
          "type": "string"
        },
        {
          "description": "Implements a trait/interface.",
          "enum": [
            "implements"
          ],
          "type": "string"
        },
        {
          "description": "Generic reference.",
          "enum": [
            "references"
          ],
          "type": "string"
        },
        {
          "description": "Defines.",
          "enum": [
            "defines"
          ],
          "type": "string"
        }
      ]
    },
    "wire.ImpactQuery": {
      "description": "Request: impact analysis (`CAPI-10`).",
      "properties": {
        "changed": {
          "description": "Changed symbols.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "edge_kinds": {
          "description": "Edge kinds to follow (empty means calls/references/implements).",
          "items": {
            "$ref": "#/$defs/wire.CodeEdgeKind"
          },
          "type": "array"
        },
        "include_test_candidates": {
          "description": "Whether test candidates should be reported.",
          "type": "boolean"
        },
        "max_depth": {
          "description": "Maximum hops.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "max_nodes": {
          "description": "Maximum visited nodes.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "revision": {
          "description": "Revision the analysis is bound to.",
          "type": "string"
        }
      },
      "required": [
        "changed",
        "edge_kinds",
        "include_test_candidates",
        "max_depth",
        "max_nodes",
        "revision"
      ],
      "type": "object"
    },
    "shared.ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shared.ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "shared.Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "shared.ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "project_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "repo_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "workspace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "agent_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "session_id": {
          "$ref": "#/$defs/shared.ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "shared.RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "trace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scope": {
          "$ref": "#/$defs/shared.ScopeRef"
        },
        "principal_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "#/$defs/shared.ISODate"
        },
        "consistency": {
          "$ref": "#/$defs/shared.Consistency"
        },
        "required_generation": {
          "$ref": "#/$defs/shared.ID"
        },
        "snapshot_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "idempotency_key": {
          "$ref": "#/$defs/shared.ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    }
  }
}
