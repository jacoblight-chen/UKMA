{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/document.get_source_span.request.schema.json",
  "title": "document.get_source_span Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.document.get_source_span.v1"
    },
    "context": {
      "$ref": "#/$defs/shared.RequestContext"
    },
    "input": {
      "$ref": "#/$defs/wire.GetSourceSpan"
    }
  },
  "$defs": {
    "wire.GetSourceSpan": {
      "description": "`document.get_source_span` (DAPI-14).",
      "properties": {
        "document_id": {
          "description": "Document id.",
          "type": "string"
        },
        "max_bytes": {
          "description": "Maximum bytes the caller accepts.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "span": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.Span"
            }
          ],
          "description": "Requested span."
        }
      },
      "required": [
        "document_id",
        "max_bytes",
        "span"
      ],
      "type": "object"
    },
    "wire.Span": {
      "description": "Half-open byte range plus 1-based lines inside one artifact.",
      "properties": {
        "byte_end": {
          "description": "End byte offset (exclusive).",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "byte_start": {
          "description": "First byte offset.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "line_end": {
          "description": "Last line (1-based, inclusive).",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "line_start": {
          "description": "First line (1-based).",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "byte_end",
        "byte_start",
        "line_end",
        "line_start"
      ],
      "type": "object"
    },
    "shared.ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shared.ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "shared.Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "shared.ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "project_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "repo_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "workspace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "agent_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "session_id": {
          "$ref": "#/$defs/shared.ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "shared.RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "trace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scope": {
          "$ref": "#/$defs/shared.ScopeRef"
        },
        "principal_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "#/$defs/shared.ISODate"
        },
        "consistency": {
          "$ref": "#/$defs/shared.Consistency"
        },
        "required_generation": {
          "$ref": "#/$defs/shared.ID"
        },
        "snapshot_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "idempotency_key": {
          "$ref": "#/$defs/shared.ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    }
  }
}
