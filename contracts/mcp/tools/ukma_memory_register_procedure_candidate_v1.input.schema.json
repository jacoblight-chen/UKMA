{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/memory.register_procedure_candidate.request.schema.json",
  "title": "memory.register_procedure_candidate Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.memory.register_procedure_candidate.v1"
    },
    "context": {
      "$ref": "#/$defs/shared.RequestContext"
    },
    "input": {
      "$ref": "#/$defs/wire.RegisterProcedure"
    }
  },
  "$defs": {
    "wire.MemoryEvidence": {
      "description": "Evidence supporting a claim (\u00a721.1 `provenance_refs`, \u00a734.1).",
      "properties": {
        "confidence": {
          "description": "Confidence the extractor assigned to this piece of evidence.",
          "format": "double",
          "type": "number"
        },
        "evidence_id": {
          "description": "Evidence id.",
          "type": "string"
        },
        "source_group": {
          "description": "Independent source group used for promotion counting (\u00a727.1).",
          "type": "string"
        },
        "source_ref": {
          "description": "Where the evidence came from, for example `artifact:sha256:...`.",
          "type": "string"
        }
      },
      "required": [
        "confidence",
        "evidence_id",
        "source_group",
        "source_ref"
      ],
      "type": "object"
    },
    "wire.MemoryKind": {
      "description": "Which memory store an item lives in (\u00a734.1).",
      "oneOf": [
        {
          "description": "Working memory: session/agent scoped and budgeted.",
          "enum": [
            "working"
          ],
          "type": "string"
        },
        {
          "description": "Episodic memory: TTL and FSRS driven.",
          "enum": [
            "episodic"
          ],
          "type": "string"
        },
        {
          "description": "Semantic memory: versioned, evidence-backed facts.",
          "enum": [
            "semantic"
          ],
          "type": "string"
        },
        {
          "description": "Procedural memory: abstract procedures only, never tool grants.",
          "enum": [
            "procedural"
          ],
          "type": "string"
        }
      ]
    },
    "wire.MemoryRef": {
      "description": "Address of one memory record.",
      "properties": {
        "id": {
          "description": "Memory id.",
          "type": "string"
        },
        "kind": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.MemoryKind"
            }
          ],
          "description": "Store the id belongs to."
        },
        "revision": {
          "description": "Revision or content tag the caller observed.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "revision"
      ],
      "type": "object"
    },
    "wire.ProcedureDraft": {
      "description": "Draft of a procedure (\u00a734.1, MAPI-20 \u2014 implemented in P6).",
      "properties": {
        "evidence": {
          "description": "Evidence.",
          "items": {
            "$ref": "#/$defs/wire.MemoryEvidence"
          },
          "type": "array"
        },
        "language": {
          "description": "BCP-47 language.",
          "type": "string"
        },
        "name": {
          "description": "Procedure name.",
          "type": "string"
        },
        "permissions": {
          "description": "Permissions the procedure needs from the host.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "preconditions": {
          "description": "Preconditions.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "source_episodes": {
          "description": "Episodes the procedure was learned from.",
          "items": {
            "$ref": "#/$defs/wire.MemoryRef"
          },
          "type": "array"
        },
        "steps": {
          "description": "Steps.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "evidence",
        "language",
        "name",
        "permissions",
        "preconditions",
        "source_episodes",
        "steps"
      ],
      "type": "object"
    },
    "wire.RegisterProcedure": {
      "description": "`memory.register_procedure_candidate` (MAPI-20 \u2014 implemented in P6).",
      "properties": {
        "draft": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.ProcedureDraft"
            }
          ],
          "description": "Draft to register."
        }
      },
      "required": [
        "draft"
      ],
      "type": "object"
    },
    "shared.ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shared.ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "shared.Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "shared.ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "project_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "repo_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "workspace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "agent_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "session_id": {
          "$ref": "#/$defs/shared.ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "shared.RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "trace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scope": {
          "$ref": "#/$defs/shared.ScopeRef"
        },
        "principal_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "#/$defs/shared.ISODate"
        },
        "consistency": {
          "$ref": "#/$defs/shared.Consistency"
        },
        "required_generation": {
          "$ref": "#/$defs/shared.ID"
        },
        "snapshot_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "idempotency_key": {
          "$ref": "#/$defs/shared.ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    }
  }
}
