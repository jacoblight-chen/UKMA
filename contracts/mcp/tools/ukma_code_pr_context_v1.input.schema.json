{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ukma.dev/v1/code.pr_context.request.schema.json",
  "title": "code.pr_context Request (Phase 4 typed candidate)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation",
    "context",
    "input"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "operation": {
      "const": "ukma.code.pr_context.v1"
    },
    "context": {
      "$ref": "#/$defs/shared.RequestContext"
    },
    "input": {
      "$ref": "#/$defs/wire.PrContextQuery"
    }
  },
  "$defs": {
    "wire.PrContextFormat": {
      "description": "Output format of `pr_context`.",
      "oneOf": [
        {
          "description": "Ready-to-post markdown (GitHub Action parity).",
          "enum": [
            "markdown"
          ],
          "type": "string"
        },
        {
          "description": "Structured data only.",
          "enum": [
            "json"
          ],
          "type": "string"
        }
      ]
    },
    "wire.PrContextQuery": {
      "description": "Request: one-call PR/change review (`pr_context` parity).",
      "properties": {
        "base_revision": {
          "description": "Revision the change is measured against.",
          "type": "string"
        },
        "format": {
          "allOf": [
            {
              "$ref": "#/$defs/wire.PrContextFormat"
            }
          ],
          "description": "Output format."
        },
        "head_revision": {
          "description": "Revision containing the change (usually the `@cwd` worktree).",
          "type": "string"
        },
        "max_depth": {
          "description": "Impact traversal depth (1..=5).",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "max_nodes": {
          "description": "Impact traversal node cap (1..=1000).",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "repository_id": {
          "description": "Repository the review is bound to.",
          "type": "string"
        }
      },
      "required": [
        "base_revision",
        "format",
        "head_revision",
        "max_depth",
        "max_nodes",
        "repository_id"
      ],
      "type": "object"
    },
    "shared.ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shared.ISODate": {
      "type": "string",
      "format": "date-time"
    },
    "shared.Consistency": {
      "enum": [
        "eventual",
        "read_your_writes",
        "snapshot",
        "strict_generation"
      ]
    },
    "shared.ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "project_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "repo_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "workspace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "agent_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "session_id": {
          "$ref": "#/$defs/shared.ID"
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ]
    },
    "shared.RequestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "trace_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scope": {
          "$ref": "#/$defs/shared.ScopeRef"
        },
        "principal_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "deadline_at": {
          "$ref": "#/$defs/shared.ISODate"
        },
        "consistency": {
          "$ref": "#/$defs/shared.Consistency"
        },
        "required_generation": {
          "$ref": "#/$defs/shared.ID"
        },
        "snapshot_id": {
          "$ref": "#/$defs/shared.ID"
        },
        "idempotency_key": {
          "$ref": "#/$defs/shared.ID"
        },
        "expected_etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delegation_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "trace_id",
        "scope",
        "principal_id",
        "scopes",
        "consistency"
      ]
    }
  }
}
